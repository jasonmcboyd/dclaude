ARG BASE_IMAGE=ubuntu:latest
FROM ${BASE_IMAGE}

# Install prerequisites (curl, git) if missing
RUN if command -v apt-get > /dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends curl git ca-certificates util-linux && rm -rf /var/lib/apt/lists/*; \
    elif command -v tdnf > /dev/null; then \
        tdnf install -y curl git ca-certificates util-linux && tdnf clean all; \
    elif command -v apk > /dev/null; then \
        apk add --no-cache curl git ca-certificates util-linux; \
    else \
        echo "ERROR: No supported package manager found (apt-get, tdnf, apk)" && exit 1; \
    fi

# Install Node.js 22 LTS
ARG NODE_VERSION=22.14.0
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
        x86_64)  NODE_ARCH="x64" ;; \
        aarch64) NODE_ARCH="arm64" ;; \
        armv7l)  NODE_ARCH="armv7l" ;; \
        *)       echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz \
        | tar -xz --strip-components=1 -C /usr/local

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# Create non-root user with fixed UID. The entrypoint starts as root for UID matching
# and drops to this user before launching Claude Code (which refuses --dangerously-skip-permissions as root).
# Fixed UID ensures consistent file ownership across image rebuilds.
# Remove any existing UID 1000 user first (e.g. 'app' in .NET SDK images).
RUN existing=$(getent passwd 1000 | cut -d: -f1); \
    if [ -n "$existing" ] && [ "$existing" != "claude" ]; then userdel "$existing"; fi; \
    useradd -m -u 1000 claude

# Install Pester 5 for running tests (only if PowerShell is available)
RUN command -v pwsh > /dev/null && pwsh -Command "Install-Module Pester -Force -Scope AllUsers -SkipPublisherCheck" || true

# Entrypoint script copies host Claude config to writable home directory
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Build steps that need to run as the claude user for correct file ownership.
USER claude
ENV HOME=/home/claude
ENV TERM=xterm-256color
ENV DCLAUDE_CONTAINER=1

# Pre-create .claude directory owned by claude so Docker doesn't create it as
# root when bind-mounting the project dir.
RUN mkdir -p /home/claude/.claude

# Switch to root for the entrypoint. It needs root to match UIDs and set ambient
# capabilities (CAP_FOWNER + CAP_DAC_OVERRIDE), then drops to claude via setpriv
# before launching Claude Code.
USER root

WORKDIR /home/claude

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
